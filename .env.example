# Django Settings
SECRET_KEY=
DEBUG=True

# Supabase API Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase / PostgreSQL Database Connection (use Session Pooler for IPv4 networks)
# Example pooler host: aws-1-ap-southeast-2.pooler.supabase.com
# Example pooler user: postgres.<your-project-ref>
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
DB_PORT=5432

# Default Mall Admin (used by: python manage.py create_default_admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tultol.local
ADMIN_PASSWORD=
